# 运行环境，可填写 development、testing 或 production
EVODEV_ENVIRONMENT=development
# PostgreSQL 连接地址，用于保存 LangGraph 检查点和可复用经验
EVODEV_DATABASE_URL=postgresql://evodev:evodev@localhost:55432/evodev
# 运行输出保存目录，例如补丁、日志和 Agent 轨迹
EVODEV_OUTPUTS_DIR=outputs
# 隔离工作区保存目录，每次任务会在此创建独立代码副本
EVODEV_WORKSPACES_DIR=.evodev/workspaces
# Prompt 进化使用的真实 Bug A/B 评测清单
EVODEV_PROMPT_BENCHMARKS_FILE=examples/prompt-evolution-benchmarks.json
# 是否在主任务回写经验后自动投递 Prompt 进化任务；Worker 仍需独立启动
EVODEV_PROMPT_EVOLUTION_AUTO_ENQUEUE=false
# 自动投递的进化任务至少需要多少条启用经验
EVODEV_PROMPT_EVOLUTION_MIN_EXPERIENCES=3
# 执行测试和代码命令时使用的 Docker 镜像
EVODEV_SANDBOX_IMAGE=evodev-python:3.13
# Docker 沙箱网络模式，none 表示禁止访问外部网络
EVODEV_SANDBOX_NETWORK=none
# 每个 Docker 沙箱最多可使用的 CPU 核数
EVODEV_SANDBOX_CPUS=2
# 每个 Docker 沙箱最多可使用的内存
EVODEV_SANDBOX_MEMORY=2g
# 每个 Docker 沙箱最多允许创建的进程数量
EVODEV_SANDBOX_PIDS_LIMIT=256
# 单条命令的默认超时时间，单位为秒
EVODEV_COMMAND_TIMEOUT_SECONDS=120
# 单条命令允许保留的最大输出大小，单位为字节
EVODEV_MAX_COMMAND_OUTPUT_BYTES=1048576
# 大语言模型名称，当前默认使用支持工具调用和 JSON 输出的 DeepSeek 模型
EVODEV_LLM_MODEL=deepseek/deepseek-v4-flash
# 大语言模型服务的访问密钥，请勿提交真实密钥
EVODEV_LLM_API_KEY=
# DeepSeek 的 OpenAI 兼容接口地址
EVODEV_LLM_BASE_URL=https://api.deepseek.com
# 费用仅为估算，不含缓存折扣等供应商计费细则；未配置价格时显示“未配置”，不视为免费
# 每百万输入 Token 的价格，请按所用模型的实际单价取消注释并填写
# EVODEV_LLM_INPUT_PRICE_PER_MILLION=1.0
# 每百万输出 Token 的价格，请按所用模型的实际单价取消注释并填写
# EVODEV_LLM_OUTPUT_PRICE_PER_MILLION=1.0
# 费用币种，使用三位大写货币代码，例如 CNY 或 USD
EVODEV_LLM_COST_CURRENCY=CNY
